{
    "compilerOptions": {
        "module": "nodenext",
        "target": "es2022",
        "strict": true,
        "skipLibCheck": true,
        "noUnusedParameters": true,
        "noUnusedLocals": true,
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "sourceMap": true
    }
}